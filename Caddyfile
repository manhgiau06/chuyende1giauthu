# Caddy Reverse Proxy cho Domain HTTPS (chuẩn Azure / Production)
# Tự động cấp phát và gia hạn chứng chỉ SSL Let's Encrypt / ZeroSSL miễn phí
#   /api/*     -> Backend Next.js :8000
#   /storage/* -> Thư mục ảnh Uploads của Backend :8000
#   /*         -> Frontend React :5173

giauthu.duckdns.org {
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /storage/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:5173
    }
}
